# NVIDIA API Configuration
# Get your key from: https://build.nvidia.com/explore/discover
NVIDIA_API_KEY=nvapi-your-key-goes-here

# Server Config
PORT=3001
SESSION_SECRET=your-session-secret-change-in-prod

# D-ID API Configuration
# Get your key from: https://studio.d-id.com/
D_ID_API_KEY=your-key-here

# MongoDB Configuration
MONGO_URI=mongodb://localhost:27017/eduavatar

# Qdrant Vector DB Configuration
# Get from: cloud.qdrant.io
QDRANT_URL=https://your-cluster-url.qdrant.tech
QDRANT_API_KEY=your-qdrant-api-key
